# The URL where your Node.js backend is deployed (must include /api).
# Development automatically falls back to the Expo host on port 5001.
EXPO_PUBLIC_BACKEND_URL=https://your-backend-url.com/api

# Local development only. Set to true to open the app without logging in.
# Production builds ignore this flag even if it is accidentally left enabled.
EXPO_PUBLIC_BYPASS_AUTH=false

# Supabase Configuration
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
DATABASE_URL="postgresql://postgres:your-db-password@your-db-host:6543/postgres"

# Authentication & URLs
# A strong 64+ character random hex string
JWT_SECRET="your-super-secret-jwt-key"
BACKEND_URL="http://localhost:5000"
# For native mobile OAuth: must be the full deep-link callback URL
# The app scheme is "ghsocial" (set in app.json)
# Note: (auth) is an Expo Router route group — parenthesized segments are stripped from URLs
# so the correct path is /callback, NOT /auth/callback
CLIENT_URL="ghsocial://callback"

# Comma-separated browser origins. Native apps do not send an Origin header.
# In production, add the deployed web frontend URL(s) here.
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"

# External APIs
GITHUB_TOKEN="ghp_your_github_personal_access_token"

# Internal service-to-service secret
# Must match INTERNAL_API_SECRET in the gh-social-ml .env
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET="your-internal-api-secret-here"

# ML Service
ML_SERVICE_URL="http://localhost:8000"
